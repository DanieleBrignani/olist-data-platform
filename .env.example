# Copy to .env and replace every CHANGE_ME value. .env is git-ignored.
# All passwords must be different; each maps to one least-privilege role (docs/adr/0009).

OLIST_ENV=local

# --- PostgreSQL connection -------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port published on the host machine (non-default to avoid clashing with a local Postgres)
POSTGRES_HOST_PORT=55432
OLIST_DB_NAME=olist_dw

# Superuser: used ONLY by infra/postgres/init at first container start
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_superuser

# Owner of meta/raw/src schemas, runs Alembic migrations
OLIST_ADMIN_PASSWORD=CHANGE_ME_admin
# Ingestion, dbt, publish
OLIST_PIPELINE_PASSWORD=CHANGE_ME_pipeline
# Read-only on published warehouse/marts
OLIST_REPORTING_PASSWORD=CHANGE_ME_reporting
# Read-only on meta (metrics exporter)
OLIST_MONITOR_PASSWORD=CHANGE_ME_monitor
# Prefect server metadata database (URL-safe characters only: it is embedded in a URL)
PREFECT_DB_PASSWORD=CHANGE_ME_prefect

# Optional: schedule for the olist-refresh deployment (cron); unset = on demand only
# OLIST_REFRESH_CRON=0 3 * * *

# --- Monitoring -------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana

# --- Logging ----------------------------------------------------------------
OLIST_LOG_LEVEL=INFO
# Optional JSON-lines file in addition to stdout (empty = stdout only)
OLIST_LOG_FILE=logs/pipeline.jsonl
